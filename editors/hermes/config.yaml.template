# REFERENCE ONLY -- not read by install.py directly. Hermes's real
# config.yaml is a large (100KB+), heavily-commented file that ships with
# its own install, and its own docs say to use `hermes config set
# <key> <value>` rather than hand-edit it -- which is exactly what
# install.py does. This file just shows the end result in one place: run
# install.py, and your real ~/.hermes/config.yaml (or, on Windows,
# %LOCALAPPDATA%\hermes\config.yaml -- confirmed live, the ~/.hermes/...
# path in Hermes's own docs is Unix-only) ends up with these values set,
# without anything else in that file being touched.
#
# The master key never gets written here or into config.yaml -- it goes
# into Hermes's own .env (path found via `hermes config env-path`) as
# LITELLM_API_KEY, resolved at runtime via key_env below.

providers:
  litellm:
    api: "http://127.0.0.1:4000/v1"
    key_env: LITELLM_API_KEY

model:
  # 👶 ELI5:
  # Points Hermes Agent to `sektor9-auto`! This gives Hermes access to the
  # cheapest top-performing model across code/plan/execute/search, backed
  # by LiteLLM's 3-tier fallback safety net (OpenRouter -> DeepInfra/Fireworks -> Gemini/Kimi).
  default: sektor9-auto
  provider: custom:litellm

mcp_servers:
  litellm-gateway:
    url: "http://127.0.0.1:4000/mcp"
    headers:
      Authorization: "Bearer ${LITELLM_API_KEY}"
