{
  "mcpServers": {
    "litellm-gateway": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://localhost:4000/mcp",
        "--allow-http",
        "--header",
        "Authorization:${LITELLM_AUTH_HEADER}"
      ],
      "env": {
        "LITELLM_AUTH_HEADER": "Bearer YOUR_LITELLM_MASTER_KEY"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}
